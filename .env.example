# MongoDB Atlas connection string (Atlas -> Connect -> Drivers)
MONGODB_URI=
MONGODB_DB_NAME=

# Auth.js — generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
# http://localhost:3000 locally, your production URL on Vercel
NEXTAUTH_URL=

# Optional: Google sign-in. Leave both empty to disable the Google button.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Cloudinary (Console -> Dashboard -> API Keys). Required for media uploads.
# Image files are stored in Cloudinary; MongoDB stores their URLs and metadata.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Public cloud identifier for next-cloudinary; use the same value as above.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
